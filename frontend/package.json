{
  "name": "buildmind-frontend",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:mock": "ng serve --configuration mock",
    "build": "ng build --configuration production",
    "build:dev": "ng build --configuration development",
    "build:mock": "ng build --configuration mock",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\"",
    "test": "ng test",
    "test:ci": "ng test --watch=false --coverage",
    "check:tokens": "node tools/check-tokens.mjs",
    "check:contrast": "node tools/check-contrast.mjs",
    "e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run check:tokens && npm run check:contrast && npm run test:ci && npm run build && npm run build:mock"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/cdk": "22.3.0",
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/router": "22.3.0",
    "@fontsource/poppins": "5.3.0",
    "gsap": "3.15.1",
    "konva": "10.10.0",
    "rxjs": "7.8.2",
    "three": "0.187.0",
    "tslib": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@angular/build": "22.3.0",
    "@angular/cli": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "@vitest/coverage-v8": "5.1.1",
    "angular-eslint": "22.8.0",
    "eslint": "10.15.0",
    "jsdom": "31.0.1",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  },
  "description": "BuildMind Customer and Admin portals (Angular 22). Phase 01 foundation.",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
