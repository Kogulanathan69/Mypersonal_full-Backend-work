<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- C9: local development secrets live in the .NET User Secrets store, never in the repository. -->
    <UserSecretsId>buildmind-api-13f8d930-0a34-4aa5-8757-cc3ebbea73de</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- BE-M4-D04: tests drive the readiness probe seam (timeouts, single-flight) without a database. -->
    <InternalsVisibleTo Include="BuildMind.Infrastructure.Tests" />
    <InternalsVisibleTo Include="BuildMind.Persistence.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../BuildMind.Application/BuildMind.Application.csproj" />
    <ProjectReference Include="../BuildMind.Infrastructure/BuildMind.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- C7 (proposed): Development-only OpenAPI document and Swagger UI. Pending M4 dependency approval. -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="11.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Design-time only: makes this project the dotnet-ef startup project. PrivateAssets keeps it out of
         consumers; EF Core design assemblies are not used by the application at run time. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
