{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "IncludeScopes": true
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 1048576
    }
  },
  "RateLimiting": {
    "Enabled": true,
    "Ipv6PrefixLength": 64,
    "Anonymous": {
      "PermitsPerMinute": 120,
      "Burst": 120,
      "GlobalCeilingPerMinute": 3000
    },
    "Authenticated": {
      "PermitsPerMinute": 300,
      "Burst": 300
    },
    "AuthStrict": {
      "PermitsPerMinute": 10
    },
    "Expensive": {
      "ConcurrentPerUser": 2,
      "GlobalConcurrent": 8,
      "RetryAfterSeconds": 2
    }
  },
  "Database": {
    "Enabled": false,
    "CommandTimeoutSeconds": 30
  },
  "Services": {
    "Python": {
      "Enabled": false,
      "BaseUrl": "",
      "TimeoutSeconds": 10
    },
    "Rag": {
      "Enabled": false,
      "BaseUrl": "",
      "TimeoutSeconds": 5
    }
  }
}
